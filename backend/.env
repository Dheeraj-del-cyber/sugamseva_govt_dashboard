# Copy this file to .env and fill in real values for production.

# --- Database ---
DATABASE_URL=sqlite:///./sugamseva.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://sugamseva:password@localhost:5432/sugamseva

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Demo mode toggle ---
# true  = DigiLocker/Bhashini/Biometric/SMS are simulated (no external creds needed)
# false = real integrations below are used
DEMO_MODE=true

# --- DigiLocker / APISetu (https://partners.digitallocker.gov.in) ---
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_BASE_URL=https://api.digitallocker.gov.in
DIGILOCKER_REDIRECT_URI=http://localhost:8000/digilocker/callback
# Dashboard URL the citizen's browser is sent back to after DigiLocker consent
FRONTEND_BASE_URL=http://localhost:5173

# --- Bhashini (https://bhashini.gov.in) ---
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_BASE_URL=https://bhashini.gov.in/api

# --- Biometric device (STQC-certified RD service) ---
BIOMETRIC_DEVICE_API_URL=

# --- SMS Gateway ---
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_BASE_URL=

# --- Firebase Cloud Messaging ---
FIREBASE_SERVER_KEY=

# --- Claude / Anthropic API (AI scheme summaries & suggestions) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6