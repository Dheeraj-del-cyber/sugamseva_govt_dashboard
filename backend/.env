# Copy this file to .env and fill in real values for production.

# --- Database ---
DATABASE_URL=sqlite:///./sugamseva.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://sugamseva:password@localhost:5432/sugamseva

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Demo mode toggle ---
# true  = Biometric device is simulated (no external creds needed)
# false = real integrations below are used
DEMO_MODE=true

FRONTEND_BASE_URL=http://localhost:5173

# --- Biometric device (STQC-certified RD service) ---
BIOMETRIC_DEVICE_API_URL=

# --- Firebase Cloud Messaging ---
FIREBASE_SERVER_KEY=